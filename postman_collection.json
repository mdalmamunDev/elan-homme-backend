              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res?.data?.verificationToken) pm.collectionVariables.set('verifyEmailToken', res.data.verificationToken);",
                  "if (res?.data?.resetPasswordToken) pm.collectionVariables.set('resetPasswordToken', res.data.resetPasswordToken);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
