        {
          "name": "Login (User)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res?.data?.tokens?.accessToken && res?.data?.user) {",
                  "  const role = res.data.user.role;",
                  "  pm.collectionVariables.set(role + 'AccessToken', res.data.tokens.accessToken);",
                  "  console.log('Logged in as ' + role + ' - token saved');",
                  "} else if (res?.data?.verifyEmailToken) {",
                  "  pm.collectionVariables.set('verifyEmailToken', res.data.verifyEmailToken);",
                  "  console.log('Email not verified - verificationToken saved, run Verify Email first');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "body": {
              "mode": "raw",
